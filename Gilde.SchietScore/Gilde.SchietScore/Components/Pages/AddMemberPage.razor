@page "/leden-toevoegen"
@using Models
@rendermode InteractiveServer

<PageTitle>Leden toevoegen</PageTitle>
<AuthorizeView Context="Auth">
    <EditForm Model=@_scoreAddForms OnSubmit=@SubmitScoreFrom>
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <h1>Leden toevoegen</h1>
        </div>
    <div style="display: flex; justify-content: flex-end; align-items: center;">
        <label style="margin-right:10px;"><b>Schiet datum:</b></label>
        <InputDate Type="InputDateType.Date" @bind-Value="@today" />
    </div>
    <div class="tableFixHeadLarge">
        <table class="table table-striped table-hover table-responsive">
            <thead>
                <tr>
                    <th>Naam</th>
                    <th>Korps</th>
                    <th>Schietendlid</th>
                </tr>
            </thead>
            <tbody>
                <tr><th></th></tr>
                <tr><th></th></tr>
                <tr><th></th></tr>
            </tbody>
        </table>
    </div>
    @if (_shootingMembers != null)
    {
        <div style="display: flex; justify-content: flex-end; align-items: center; margin-top: 20px;">
            <input type="submit" value="Opslaan" class="btn btn-primary" />
        </div>
    }
    </EditForm>
    
</AuthorizeView>