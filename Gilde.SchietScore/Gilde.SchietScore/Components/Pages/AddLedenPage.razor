@page "/leden-toevoegen"
@using Models
@rendermode InteractiveServer

<PageTitle>Leden toevoegen</PageTitle>
<AuthorizeView Context="Auth">
    <EditForm Model=@_ledenAddForms OnSubmit=@SubmitScoreFrom>
        <AntiforgeryToken />
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <h1>Leden toevoegen</h1>
        </div>
    <div style="display: flex; justify-content: flex-end; align-items: center;">
        <label style="margin-right:10px;"><b>Schiet datum:</b></label>
        <InputDate Type="InputDateType.Date" @bind-Value="@today" />
    </div>
    <div class="tableFixHeadLarge">
        <table class="table table-striped table-hover table-responsive">
            <thead>
                <tr>
                    <th>Naam</th>
                    <th>Schietendlid</th>
                </tr>
            </thead>
            <tbody>
            @foreach(var lid in _ledenAddForms){
                <tr>
                    <th>
                        <InputText @bind-Value="@lid.Naam" />
                    </th>
                    <th>
                        <InputCheckbox @bind-Value="@lid.IsSchietendLid" />
                    </th>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 20px;">
        <div>
            <input type="button" class="btn btn-primary" value="Regel toevoegen" @onclick="AddExtraLid" />
            <input type="button" class="btn btn-primary" value="Laatste regel verwijderen" @onclick="RemoveExtraLid" />
        </div>
        <div>
            <input type="submit" value="Opslaan" class="btn btn-primary" />
        </div>
    </div>
    </EditForm>
    
</AuthorizeView>